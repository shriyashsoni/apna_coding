{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apnacoding.site"
        }
      ],
      "destination": "https://apnacoding.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.apnacoding.site"
        }
      ],
      "destination": "https://apnacoding.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap?type=static"
    },
    {
      "source": "/sitemap-hackathons.xml",
      "destination": "/api/sitemap?type=hackathons"
    },
    {
      "source": "/sitemap-jobs.xml",
      "destination": "/api/sitemap?type=jobs"
    },
    {
      "source": "/sitemap-events.xml",
      "destination": "/api/sitemap?type=events"
    },
    {
      "source": "/sitemap-news.xml",
      "destination": "/api/sitemap?type=news"
    },
    {
      "source": "/sitemap-communities.xml",
      "destination": "/api/sitemap?type=communities"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/sitemap?type=products"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
