call_tool("replace_file", "src/pages/Community.tsx", "import { Navbar } from \"@/components/Navbar\";\nimport { Footer } from \"@/components/Footer\";\nimport { usePaginatedQuery, useMutation } from \"convex/react\";\nimport { api } from \"@/convex/_generated/api\";\nimport { Button } from \"@/components/ui/button\";\nimport { MessageSquare, Heart, Share2, Send, User } from \"lucide-react\";\nimport { motion } from \"framer-motion\";\nimport { useState } from \"react\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { toast } from \"sonner\";\nimport { useAuth } from \"@/hooks/use-auth\";\n\nexport default function Community() {\n  const { results, status, loadMore } = usePaginatedQuery(\n    api.posts.get,\n    {},\n    { initialNumItems: 10 }\n  );\n  const createPost = useMutation(api.posts.create);\n  const likePost = useMutation(api.posts.like);\n  const { isAuthenticated } = useAuth();\n  \n  const [newPost, setNewPost] = useState(\"\");\n  const [isSubmitting, setIsSubmitting] = useState(false);\n\n  const handlePost = async () => {\n    if (!newPost.trim()) return;\n    if (!isAuthenticated) {\n      toast.error(\"Please sign in to post\");\n      return;\n    }\n\n    setIsSubmitting(true);\n    try {\n      await createPost({ content: newPost, type: \"discussion\" });\n      setNewPost(\"\");\n      toast.success(\"Post created successfully\");\n    } catch (error) {\n      toast.error(\"Failed to create post\");\n      console.error(error);\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const handleLike = async (postId: any) => {\n    try {\n      await likePost({ postId });\n    } catch (error) {\n      console.error(error);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-background text-foreground\">\n      <Navbar />\n      \n      <main className=\"flex-1 container mx-auto px-4 py-12 max-w-4xl\">\n        <div className=\"mb-12 text-center\">\n          <h1 className=\"text-4xl font-bold mb-2 cyber-glitch\" data-text=\"Developer Community\">Developer Community</h1>\n          <p className=\"text-muted-foreground\">Connect, share, and grow with fellow developers.</p>\n        </div>\n\n        {/* Create Post */}\n        <div className=\"bg-card border border-primary/20 rounded-lg p-6 mb-8 shadow-[0_0_20px_rgba(0,255,255,0.05)]\">\n          <h3 className=\"text-lg font-bold mb-4 flex items-center\">\n            <MessageSquare className=\"mr-2 h-5 w-5 text-primary\" /> Start a Discussion\n          </h3>\n          <Textarea \n            placeholder=\"What's on your mind? Share code, ask questions, or discuss tech...\"\n            className=\"bg-background/50 border-primary/20 min-h-[100px] mb-4 focus:border-primary\"\n            value={newPost}\n            onChange={(e) => setNewPost(e.target.value)}\n          />\n          <div className=\"flex justify-end\">\n            <Button \n              onClick={handlePost} \n              disabled={isSubmitting || !newPost.trim()}\n              className=\"bg-primary text-primary-foreground hover:bg-primary/90\"\n            >\n              <Send className=\"mr-2 h-4 w-4\" /> Post\n            </Button>\n          </div>\n        </div>\n\n        {/* Feed */}\n        <div className=\"space-y-6\">\n          {status === \"LoadingFirstPage\" ? (\n            [1, 2, 3].map((i) => (\n              <div key={i} className=\"h-40 rounded-lg bg-card/30 animate-pulse border border-primary/10\" />\n            ))\n          ) : results.length === 0 ? (\n            <div className=\"text-center py-20 border border-dashed border-primary/20 rounded-lg bg-card/10\">\n              <MessageSquare className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n              <h3 className=\"text-xl font-bold mb-2\">No posts yet</h3>\n              <p className=\"text-muted-foreground\">Be the first to start a conversation!</p>\n            </div>\n          ) : (\n            results.map((post, i) => (\n              <motion.div\n                key={post._id}\n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ delay: i * 0.05 }}\n                className=\"bg-card border border-primary/10 rounded-lg p-6 hover:border-primary/30 transition-all\"\n              >\n                <div className=\"flex items-start gap-4\">\n                  <Avatar className=\"h-10 w-10 border border-primary/30\">\n                    <AvatarImage src={post.author?.image} />\n                    <AvatarFallback className=\"bg-primary/10 text-primary\"><User className=\"h-5 w-5\" /></AvatarFallback>\n                  </Avatar>\n                  <div className=\"flex-1\">\n                    <div className=\"flex justify-between items-start\">\n                      <div>\n                        <h4 className=\"font-bold text-primary\">{post.author?.name || \"Anonymous\"}</h4>\n                        <p className=\"text-xs text-muted-foreground\">\n                          {/* We don't have creation time in the enriched object explicitly unless we add it, \n                              but _creationTime is on the post object from Convex */}\n                          {new Date(post._creationTime).toLocaleDateString()}\n                        </p>\n                      </div>\n                      <span className=\"text-xs bg-primary/10 text-primary px-2 py-1 rounded border border-primary/20 uppercase\">\n                        {post.type}\n                      </span>\n                    </div>\n                    <p className=\"mt-3 text-foreground/90 whitespace-pre-wrap\">{post.content}</p>\n                    \n                    <div className=\"flex items-center gap-6 mt-6 pt-4 border-t border-primary/10\">\n                      <Button \n                        variant=\"ghost\" \n                        size=\"sm\" \n                        className=\"text-muted-foreground hover:text-secondary hover:bg-secondary/10\"\n                        onClick={() => handleLike(post._id)}\n                      >\n                        <Heart className=\"mr-2 h-4 w-4\" /> {post.likes} Likes\n                      </Button>\n                      <Button variant=\"ghost\" size=\"sm\" className=\"text-muted-foreground hover:text-primary hover:bg-primary/10\">\n                        <MessageSquare className=\"mr-2 h-4 w-4\" /> Comment\n                      </Button>\n                      <Button variant=\"ghost\" size=\"sm\" className=\"text-muted-foreground hover:text-accent hover:bg-accent/10 ml-auto\">\n                        <Share2 className=\"mr-2 h-4 w-4\" /> Share\n                      </Button>\n                    </div>\n                  </div>\n                </div>\n              </motion.div>\n            ))\n          )}\n        </div>\n        \n        {status === \"CanLoadMore\" && (\n          <div className=\"flex justify-center mt-12\">\n            <Button onClick={() => loadMore(10)} variant=\"outline\" className=\"border-primary/50\">\n              Load More Posts\n            </Button>\n          </div>\n        )}\n      </main>\n      <Footer />\n    </div>\n  );\n}")
