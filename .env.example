# Convex
VITE_CONVEX_URL=your_convex_url_here

# Email Configuration for Contact Form
# To enable email functionality, add these to your Convex environment variables:
# Go to Convex Dashboard → Settings → Environment Variables
EMAIL_USER=apnacoding.tech@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here

# How to get Gmail App Password:
# 1. Go to your Google Account settings
# 2. Enable 2-Factor Authentication
# 3. Go to Security → 2-Step Verification → App passwords
# 4. Generate a new app password for "Mail"
# 5. Copy the 16-character password and add it as EMAIL_PASSWORD in Convex
